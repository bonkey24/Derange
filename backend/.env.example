# Django Secret Key (change in production)
SECRET_KEY=django-insecure-seating-project-dev-key-change-in-production

# Debug mode (1 = True, 0 = False)
DJANGO_DEBUG=1

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Allowed CORS origins for frontend (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file path (optional, defaults to BASE_DIR / 'db.sqlite3')
DJANGO_DB_PATH=

